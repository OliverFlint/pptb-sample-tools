{
  "name": "pptb-dataverse-finance-operations-sample",
  "version": "0.1.0",
  "description": "Read Dataverse accounts and F&O customers in one multi-connection tool.",
  "displayName": "Dataverse + F&O Explorer",
  "author": "Power Platform ToolBox",
  "license": "GPL-3.0",
  "devDependencies": {
    "@pptb/types": "1.3.0",
    "shx": "^0.4.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc && npm run copy-html",
    "copy-html": "shx cp src/index.html dist/",
    "test": "npm run build && node --test tests/sample.test.mjs",
    "finalize-package": "npm shrinkwrap",
    "validate": "pptb-validate",
    "test:built": "node --test tests/sample.test.mjs"
  },
  "features": {
    "minAPI": "1.3.0",
    "connections": {
      "slots": [
        {
          "label": "Dataverse accounts",
          "connectionTypes": [
            "dataverse"
          ],
          "required": true
        },
        {
          "label": "F&O customers",
          "connectionTypes": [
            "financeOperations"
          ],
          "required": true
        }
      ]
    }
  },
  "main": "index.html",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json"
  ]
}
